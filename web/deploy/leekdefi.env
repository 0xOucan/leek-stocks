# vpsinfra registry entry. Copy to projects/leekdefi.env in that repository.
# Field names follow projects/leekwallet.env; nothing here is secret - the
# WalletConnect project id is a public client identifier and is passed as a
# build arg by the deploy script, not stored here.
PROJECT_NAME=leekdefi
# CONFIRM BEFORE DEPLOYING. leekwallet.0xoucanproject.xyz is already the
# firmware site, so this is a new name chosen to cover the lending market as
# well as the ETFs, which will share the host.
HOSTNAME=leekdefi.0xoucanproject.xyz
SOURCE_TYPE=github-public
REPOSITORY=https://github.com/0xOucan/leek-stocks.git
BRANCH=main
APP_TYPE=static
CONTAINER_PORT=8080
# The dapp's own index, not /prices: /prices is proxied to the feed container,
# so health-checking it would report the feed's health as the dapp's.
HEALTH_PATH=/
DATABASE_TYPE=none
DOCKERFILE=web/deploy/Dockerfile
# The repository root, because the Dockerfile copies web/ from it.
BUILD_CONTEXT=.
MEMORY_LIMIT=128m
CPU_LIMIT=0.50
# caddy file-server writes nothing, so no writable layer is needed.
READ_ONLY=true
PREPARE_DOCKERFILE=
PREPARE_COMMAND=
CADDY_TEMPLATE=projects/leekdefi.caddy.tmpl
