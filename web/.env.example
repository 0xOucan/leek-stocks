# Copy to .env (git-ignored).
#
# Every VITE_* value is substituted into the JavaScript at build time and
# shipped to the browser, so all of it is public by definition. Nothing secret
# may go in this file: no private keys, no API keys that carry authority, no
# tokens. The publisher key lives in the feed service's systemd
# EnvironmentFile, not here.

# WalletConnect (Reown) project id, from https://dashboard.reown.com.
# A project id is a public routing identifier, not a credential. Left empty,
# the WalletConnect option renders disabled with a one-line reason instead of
# failing when someone clicks it.
VITE_REOWN_PROJECT_ID=

# Read RPC for balances, reserves and liabilities. Mezo publishes one testnet
# endpoint and there is no second provider, so this is a single point of
# failure; it is a variable so it can be pointed at a private node without a
# code change. See README, "The RPC".
VITE_RPC_URL=https://rpc.test.mezo.org

# The feed's /prices endpoint. Leave it empty: Caddy proxies /prices on this
# same host to the feed container, so the request is same-origin and needs no
# CORS and no connect-src entry in the CSP. Vite's dev server proxies the same
# path to 127.0.0.1:8787. Setting an absolute URL here works, and then that
# origin must be added to connect-src in deploy/leekdefi.caddy.tmpl.
VITE_FEED_URL=

# A WalletConnect project id is a public client identifier: it travels in every
# relay URL and grants nothing but relay quota. That is why it belongs in a
# compiled-in VITE_ variable. Nothing that grants authority does.

# Absolute origin this build is served from. Used for the Open Graph URL and
# image, which must be absolute to resolve in a link preview.
VITE_PUBLIC_URL=https://leekdefi.0xoucanproject.xyz

# Deployed addresses, from the deploy script's output. All of these are empty
# until the contracts are deployed; with any of them missing the app still
# renders and says that index is not deployed yet, rather than throwing.
VITE_VAULT_GOLOGGLE=
VITE_VAULT_AMEZON=
VITE_SHARE_GOLOGGLE=
VITE_SHARE_AMEZON=

# The real MUSD on Mezo testnet. 18 decimals, confirmed by the fork test.
VITE_MUSD=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# The test-token faucet, from the sibling leek-lend repository. Optional, and
# empty until it is deployed: with no address the faucet section says so in one
# line instead of appearing broken. The contract refuses to operate on a
# mainnet chain id, and the page hides the section on those chains to match.
VITE_FAUCET=

# The mock tokens that faucet serves, comma-separated. Their symbols carry a
# leek prefix - leekMUSD, leekwBTC, leekWETH - because Mezo's own bridged
# tokens use m (mUSDC, mUSDT, mDAI are real contracts) and a mock named mMUSD
# would read as one of theirs. The page reads each symbol from its token rather
# than trusting this list, so a wrong address shows nothing rather than a
# wrong name.
VITE_FAUCET_TOKENS=
